{
	// Konfiguracja PRODUKCYJNA (wspolniak.com). Osobny plik, bo @cloudflare/vite-plugin
	// piecze do builda WYŁĄCZNIE konfigurację top-level (bez bloków env). Wybiera ją
	// vite.config.ts, gdy skrypt build:production ustawi DEPLOY_ENV=production.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wspolniak",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/server.ts",
	"routes": [
		{ "pattern": "wspolniak.com", "custom_domain": true },
		{ "pattern": "docs.wspolniak.com", "custom_domain": true }
	],
	"vars": {
		"APP_URL": "https://wspolniak.com"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Pliki postów (#243): prywatny bucket produkcyjny BEZ lifecycle rule — trwałe.
	"r2_buckets": [
		{
			"binding": "POST_FILES",
			"bucket_name": "wspolniak-post-files"
		}
	],
	// Usunięcie klasy DO czatu (#245): API wymaga explicite delete-class — bez
	// tego nowa wersja workera bez ChatRoom odrzuca się z kodem 10064.
	// Tag v1 zostaje w historii (już zaaplikowany na produkcji), v2 usuwa klasę.
	"migrations": [
		{
			"tag": "v1-chat-room",
			"new_sqlite_classes": ["ChatRoom"]
		},
		{
			"tag": "v2-remove-chat-room",
			"deleted_classes": ["ChatRoom"]
		}
	],
	"triggers": {
		"crons": ["0 6 * * *"]
	}
}
