{
	// Konfiguracja PRODUKCYJNA (wspolniak.com). Osobny plik, bo @cloudflare/vite-plugin
	// piecze do builda WYŁĄCZNIE konfigurację top-level (bez bloków env). Wybiera ją
	// vite.config.ts, gdy skrypt build:production ustawi DEPLOY_ENV=production.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wspolniak",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/server.ts",
	"routes": [{ "pattern": "wspolniak.com", "custom_domain": true }],
	"vars": {
		"APP_URL": "https://wspolniak.com"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-chat-room",
			"new_sqlite_classes": ["ChatRoom"]
		}
	],
	"triggers": {
		"crons": ["0 6 * * *", "7 * * * *"]
	}
}
