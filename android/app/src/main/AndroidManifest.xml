<?xml version="1.0" encoding="utf-8"?>
<!-- Issue #221: brak autoVerify (decyzja z planu) — admin wybierze „Wspólniak → Zawsze" w chooserze. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Wspolniak">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Cała domena wspolniak.com (apex + www), http + https. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="wspolniak.com" />
                <data android:scheme="https" android:host="www.wspolniak.com" />
                <data android:scheme="http" android:host="wspolniak.com" />
                <data android:scheme="http" android:host="www.wspolniak.com" />
            </intent-filter>

            <!-- F3 (#222): przyjmowanie udostępnionych mediów (tylko image/video —
                 tekst celowo nie oferuje Wspólniaka w chooserze). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
