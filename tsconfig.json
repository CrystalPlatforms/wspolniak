{
	"include": ["**/*.ts", "**/*.tsx"],
	// ai-demo to OSOBNY projekt (własny routeTree + konfiguracja) — jego pliki
	// nie mogą się mieszać do typów głównej aplikacji (konflikt Register w
	// @tanstack/react-router rozbijał kontekst tras na `never`).
	"exclude": ["node_modules", "ai-demo"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "vitest/globals"],

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,

		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
