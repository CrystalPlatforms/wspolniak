{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wspolniak-dev",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/server.ts",
	"vars": {
		"APP_URL": "http://192.168.9.14:3000"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	// Załączniki czatu (F4 #217): prywatny bucket, obiekty kasuje reguła lifecycle
	// `--expire-days 1` (krok 0 HITL — zakłada właściciel; realne okno 24–48h).
	"r2_buckets": [
		{
			"binding": "CHAT_ATTACHMENTS",
			"bucket_name": "wspolniak-chat-attachments-dev"
		}
	],
	"migrations": [
		{
			"tag": "v1-chat-room",
			"new_sqlite_classes": ["ChatRoom"]
		}
	],
	"triggers": {
		"crons": ["0 6 * * *", "7 * * * *"]
	}
	// Deploy PRODUKCYJNY (wspolniak.com) używa osobnego pliku: wrangler.prod.jsonc.
	// vite.config.ts wybiera go, gdy build:production ustawi DEPLOY_ENV=production,
	// bo @cloudflare/vite-plugin piecze do builda wyłącznie konfigurację top-level
	// (bloki "env" są ignorowane przy deployu — stąd dawniej deploy:production
	// trafiało zawsze na wspolniak-dev zamiast na wspolniak.com).
}
