{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wspolniak-dev",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/server.ts",
	"vars": {
		"APP_URL": "http://192.168.9.14:3000"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Pliki postów (#243): prywatny bucket BEZ lifecycle rule — załączniki
	// rodzinne są trwałe (archiwum).
	"r2_buckets": [
		{
			"binding": "POST_FILES",
			"bucket_name": "wspolniak-post-files-dev"
		}
	],
	// Usunięcie klasy DO czatu (#245): API wymaga explicite delete-class.
	// Tag v1 zostaje w historii (już zaaplikowany na dev), v2 usuwa klasę.
	"migrations": [
		{
			"tag": "v1-chat-room",
			"new_sqlite_classes": ["ChatRoom"]
		},
		{
			"tag": "v2-remove-chat-room",
			"deleted_classes": ["ChatRoom"]
		}
	],
	"triggers": {
		"crons": ["0 6 * * *"]
	}
	// Deploy PRODUKCYJNY (wspolniak.com) używa osobnego pliku: wrangler.prod.jsonc.
	// vite.config.ts wybiera go, gdy build:production ustawi DEPLOY_ENV=production,
	// bo @cloudflare/vite-plugin piecze do builda wyłącznie konfigurację top-level
	// (bloki "env" są ignorowane przy deployu — stąd dawniej deploy:production
	// trafiało zawsze na wspolniak-dev zamiast na wspolniak.com).
}
