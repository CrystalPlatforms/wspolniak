{
	"name": "tanstack-start-on-cloudflare",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.21.0",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build && node scripts/inject-sw-version.mjs",
		"build:production": "vite build --mode production && node scripts/inject-sw-version.mjs",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy:production": "pnpm run build:production && wrangler deploy --env=''",
		"serve": "vite preview",
		"cf-typegen": "wrangler types --env-interface Env",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"types": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:ci": "biome ci .",
		"knip": "knip",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run",
		"deps": "taze",
		"deps:update": "taze -w",
		"deps:major": "taze major",
		"deps:major:update": "taze major -w",
		"db:dev:generate": "dotenvx run -f .dev.vars -- drizzle-kit generate --config drizzle-dev.config.ts",
		"db:dev:migrate": "dotenvx run -f .dev.vars -- drizzle-kit migrate --config drizzle-dev.config.ts",
		"db:dev:pull": "dotenvx run -f .dev.vars -- drizzle-kit pull --config drizzle-dev.config.ts",
		"db:dev:studio": "dotenvx run -f .dev.vars -- drizzle-kit studio --config drizzle-dev.config.ts",
		"db:dev:seed": "dotenvx run -f .dev.vars -- tsx scripts/seed.ts",
		"admin:dev:regenerate": "dotenvx run -f .dev.vars -- tsx scripts/regenerate-admin-token.ts",
		"admin:production:regenerate": "dotenvx run -f .production.vars -- tsx scripts/regenerate-admin-token.ts",
		"calendar:dev:trigger": "dotenvx run -f .dev.vars -- tsx scripts/trigger-calendar-job.ts",
		"db:production:generate": "dotenvx run -f .production.vars -- drizzle-kit generate --config drizzle-production.config.ts",
		"db:production:migrate": "dotenvx run -f .production.vars -- drizzle-kit migrate --config drizzle-production.config.ts",
		"db:production:pull": "dotenvx run -f .production.vars -- drizzle-kit pull --config drizzle-production.config.ts"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@mdxeditor/editor": "^4.2.0",
		"@neondatabase/serverless": "^1.1.0",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-slot": "^1.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-form": "^1.33.3",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@tanstack/react-router": "^1.170.20",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/react-router-ssr-query": "^1.167.1",
		"@tanstack/react-start": "^1.168.37",
		"class-variance-authority": "^0.7.1",
		"client-zip": "^2.5.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.0",
		"lucide-react": "^0.476.0",
		"motion": "^13.1.1",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"vite-tsconfig-paths": "^5.1.4",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@cloudflare/vite-plugin": "^1.51.0",
		"@dotenvx/dotenvx": "^1.75.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^22.20.1",
		"@types/pngjs": "^6.0.5",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^4.7.0",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^26.1.0",
		"knip": "^6.32.0",
		"pg": "^8.22.0",
		"pngjs": "^7.0.0",
		"semantic-release": "^25.0.9",
		"taze": "^19.17.2",
		"tsx": "^4.23.9",
		"typescript": "^5.9.3",
		"vite": "7.1.2",
		"vitest": "^4.1.10",
		"web-vitals": "^4.2.4",
		"wrangler": "^4.119.0"
	}
}
